# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_ANON_KEY endi kerak emas: brauzer bazaga to'g'ridan-to'g'ri
# murojaat qilmaydi, hamma so'rov Netlify funksiyalari orqali boradi.

# ---- Imzo kalitlari ----
# MAJBURIY, kamida 16 belgi. Zaxira qiymat YO'Q: o'rnatilmasa admin login
# ishlamaydi va hech qanday admin sessiyasi qabul qilinmaydi.
SESSION_SECRET=replace-with-long-random-string
# Brauzer orqali kirish tokenlari uchun. Bo'lmasa TELEGRAM_BOT_TOKEN ishlatiladi,
# lekin alohida qo'yilsa bot tokenini almashtirganda foydalanuvchilar tizimdan
# chiqib ketmaydi.
WEB_JWT_SECRET=replace-with-another-long-random-string

# ---- Sayt ----
APP_BASE_URL=https://your-site.netlify.app

# ---- To'lov ----
PAYMENT_CARD_NUMBER=8600123412341234
PAYMENT_CARD_OWNER=Company Name
